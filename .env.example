# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# App
APP_ENV=development
SECRET_KEY=
# Allowed CORS origins (required for staging/production).
# Accepts JSON list (recommended) or comma-separated values.
# Malformed bracket syntax like [http://localhost:3000] is also normalized.
# Staging API must include the frontend origin, e.g.:
# CORS_ALLOW_ORIGINS='["https://staging.klarnow.ai"]'
# Multiple origins: CORS_ALLOW_ORIGINS='["https://staging.klarnow.ai","https://app.klarnow.ai"]'
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRY_TIME=60
REFRESH_TOKEN_EXPIRY_DAYS=30
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=

# Optional: Published website builder sites (subdomain URLs)
# When set, published sites use brand-name subdomains (e.g. acme.klarnow.ai).
# Staging: SITES_DOMAIN=staging.klarnow.ai -> {brand-slug}.staging.klarnow.ai
# Production: SITES_DOMAIN=klarnow.ai -> {brand-slug}.klarnow.ai
# Requires wildcard DNS (e.g. *.staging.klarnow.ai) pointing to the backend.
# SITES_DOMAIN=

# Optional: onboarding
ONBOARDING_SESSION_EXPIRY_DAYS=1

# Optional: DB pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=30
# Leave unset to auto-enable in staging/production and disable in development.
# DB_POOL_PRE_PING=
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT_SECONDS=5

# Optional: Resend (email / magic link)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
SUPPORT_EMAIL=sooreoluwa@klarnow.co.uk
# Optional: failure alert recipient. Falls back to SUPPORT_EMAIL when unset.
FAILURE_ALERT_TO_EMAIL=
# Optional: waitlist signup notification recipient.
WAITLIST_NOTIFICATION_TO_EMAIL=team@klarnow.co.uk

# Storage (PocketBase)
POCKETBASE_URL=https://your-pocketbase-instance.example.com
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Optional: Storage (S3) — only needed when running the S3→PocketBase migration script
# STORAGE_PROVIDER=s3
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Optional: AI providers
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as an alias for GEMINI_API_KEY.
GEMINI_LOGO_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
# Cost guards: keep these off unless you explicitly want the extra OpenAI spend.
AI_CHAT_PROMPT_SUGGESTIONS_ENABLED=false
AI_SPRINT_TODAY_TASKS_ENABLED=false
AI_SPRINT_FIELD_SUGGESTIONS_ENABLED=false
AI_BRAND_IDENTITY_SUGGESTIONS_ENABLED=false
# Logo generation uses Gemini when enabled.
AI_LOGO_GENERATION_ENABLED=false
AI_BRAND_OS_REASONING_ENABLED=false

# Optional: Redis onboarding worker queue
# Required for background onboarding completion.
REDIS_URL=redis://localhost:6379/0
ONBOARDING_QUEUE_STREAM_KEY=klarnow:onboarding:stream
ONBOARDING_QUEUE_CONSUMER_GROUP=onboarding-workers
ONBOARDING_QUEUE_DELAYED_KEY=klarnow:onboarding:delayed
ONBOARDING_QUEUE_BLOCK_MS=5000
ONBOARDING_QUEUE_CLAIM_IDLE_MS=60000
ONBOARDING_QUEUE_BATCH_SIZE=1
ONBOARDING_QUEUE_STREAM_MAXLEN=1000
ONBOARDING_QUEUE_DISPATCH_TTL_SECONDS=86400
ONBOARDING_QUEUE_RETRY_BASE_DELAY_SECONDS=5
ONBOARDING_QUEUE_RETRY_MAX_DELAY_SECONDS=300

# Optional: chat attachments
CHAT_ATTACHMENT_MAX_SIZE_MB=20
CHAT_ATTACHMENT_MAX_TEXT_CHARS=20000
CHAT_ATTACHMENT_PROMPT_MAX_CHARS=12000
CHAT_ATTACHMENT_MAX_PER_MESSAGE=8

# Optional: Global reference markdown KB (chat/proposals grounding)
REFERENCE_DOC_ENABLED=false
# Repo-relative or absolute path to your markdown reference document
REFERENCE_DOC_PATH=backend/app/core/docs/100M-Leads.md
REFERENCE_DOC_EMBEDDING_MODEL=text-embedding-3-small
REFERENCE_DOC_CHUNK_CHARS=1200
REFERENCE_DOC_CHUNK_OVERLAP_CHARS=200
REFERENCE_DOC_TOP_K=5
REFERENCE_DOC_MIN_SCORE=0.2
REFERENCE_DOC_MAX_CHARS=250000
REFERENCE_DOC_CACHE_TTL_SECONDS=300

# Optional: Kling API (official - api-singapore.klingai.com, for Ad Factory video render)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
