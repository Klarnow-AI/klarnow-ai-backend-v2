# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# App
APP_ENV=development
SECRET_KEY=
ACCESS_TOKEN_EXPIRY_TIME=60
FRONTEND_URL=http://localhost:3000

# Optional: onboarding
ONBOARDING_SESSION_EXPIRY_DAYS=1

# Optional: Resend (email / magic link)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Optional: Storage (S3)
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_URL=

# Optional: OpenAI (for agents in later phases)
OPENAI_API_KEY=
