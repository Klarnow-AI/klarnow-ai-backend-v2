# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# App
APP_ENV=development
SECRET_KEY=
# Allowed CORS origins (required for staging/production).
# Accepts JSON list (recommended) or comma-separated values.
# Staging API must include the frontend origin, e.g.:
#   CORS_ALLOW_ORIGINS='["https://staging.klarnow.ai"]'
# Multiple origins: CORS_ALLOW_ORIGINS='["https://staging.klarnow.ai","https://app.klarnow.ai"]'
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRY_TIME=60
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=

# Optional: Published website builder sites (subdomain URLs)
# When set, published sites use brand-name subdomains (e.g. acme.klarnow.ai).
# Staging: SITES_DOMAIN=staging.klarnow.ai -> {brand-slug}.staging.klarnow.ai
# Production: SITES_DOMAIN=klarnow.ai -> {brand-slug}.klarnow.ai
# Requires wildcard DNS (e.g. *.staging.klarnow.ai) pointing to the backend.
# SITES_DOMAIN=

# Optional: onboarding
ONBOARDING_SESSION_EXPIRY_DAYS=1

# Optional: DB pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# Optional: Resend (email / magic link)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
SUPPORT_EMAIL=sooreoluwa@klarnow.co.uk

# Optional: Storage (S3)
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_URL=

# Optional: OpenAI (for agents in later phases)
OPENAI_API_KEY=

# Optional: chat attachments
CHAT_ATTACHMENT_MAX_SIZE_MB=20
CHAT_ATTACHMENT_MAX_TEXT_CHARS=20000
CHAT_ATTACHMENT_PROMPT_MAX_CHARS=12000
CHAT_ATTACHMENT_MAX_PER_MESSAGE=8

# Optional: Global reference markdown KB (chat/proposals grounding)
REFERENCE_DOC_ENABLED=true
# Repo-relative or absolute path to your markdown reference document
REFERENCE_DOC_PATH=app/core/reference/100M-Leads.md
REFERENCE_DOC_EMBEDDING_MODEL=text-embedding-3-small
REFERENCE_DOC_CHUNK_CHARS=1200
REFERENCE_DOC_CHUNK_OVERLAP_CHARS=200
REFERENCE_DOC_TOP_K=5
REFERENCE_DOC_MIN_SCORE=0.2
REFERENCE_DOC_MAX_CHARS=250000
REFERENCE_DOC_CACHE_TTL_SECONDS=300

# Optional: Pack image context retrieval (pgvector + embeddings)
IMAGE_CONTEXT_ENABLED=false
IMAGE_CONTEXT_TOP_K=3
IMAGE_CONTEXT_MIN_SCORE=0.2
IMAGE_CONTEXT_EMBEDDING_MODEL=text-embedding-3-small
IMAGE_CONTEXT_CAPTION_MODEL=gpt-4o-mini
IMAGE_CONTEXT_JOB_POLL_SECONDS=2
IMAGE_CONTEXT_JOB_MAX_ATTEMPTS=3
IMAGE_CONTEXT_PREVIEW_URL_TTL_SECONDS=900
IMAGE_CONTEXT_CHAT_ENABLED=true
IMAGE_CONTEXT_POSTER_ENABLED=true

# Optional: Kling API (official - api-singapore.klingai.com, for Ad Factory video render)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
