# Backend API base URL (no trailing slash).
# Local dev: http://localhost:8000
# Staging/prod: set to hosted backend HTTPS URL (never localhost).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only backend base URL for Next.js route handlers (runtime in container)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# Required for /api/generate and /api/generate-poster (poster/creative generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: disable poster retrieval forwarding from Next route if needed
IMAGE_CONTEXT_POSTER_ENABLED=true
