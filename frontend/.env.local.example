# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# Required for /api/generate and /api/generate-poster (poster/creative generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: disable poster retrieval forwarding from Next route if needed
IMAGE_CONTEXT_POSTER_ENABLED=true
